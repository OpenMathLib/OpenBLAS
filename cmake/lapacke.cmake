set(lapacke_dir "${NETLIB_LAPACK_DIR}/LAPACKE")

function(openblas_lapacke_sources result)
  include("${lapacke_dir}/src/CMakeLists.txt")
  include("${lapacke_dir}/utils/CMakeLists.txt")

  # Reconcile the Netlib lists with the sources bundled in OpenBLAS.
  list(REMOVE_ITEM COMMON_SOURCES lapacke_alloc.c)
  list(REMOVE_ITEM SOURCES_COMPLEX lapacke_crot.c lapacke_crot_work.c)
  list(REMOVE_ITEM SOURCES_COMPLEX16 lapacke_zrot.c lapacke_zrot_work.c)
  list(REMOVE_ITEM SOURCES_DOUBLE lapacke_sbdsvdmr3.c lapacke_sbdsvdmr3_work.c)
  list(APPEND SOURCES_SINGLE lapacke_sbdsvdmr3.c lapacke_sbdsvdmr3_work.c)
  list(APPEND SOURCES_SINGLE lapacke_sstebr.c lapacke_sstebr_work.c)
  list(APPEND SOURCES_DOUBLE lapacke_dstebr.c lapacke_dstebr_work.c)

  set(sources ${SOURCES} ${COMMON_SOURCES})
  set(prefixes "")
  if(BUILD_SINGLE)
    list(APPEND sources ${SOURCES_SINGLE})
    string(APPEND prefixes s)
  endif()
  if(BUILD_DOUBLE)
    list(APPEND sources ${SOURCES_DOUBLE})
    string(APPEND prefixes d)
  endif()
  if(BUILD_COMPLEX)
    list(APPEND sources ${SOURCES_COMPLEX})
    string(APPEND prefixes c)
  endif()
  if(BUILD_COMPLEX16)
    list(APPEND sources ${SOURCES_COMPLEX16})
    string(APPEND prefixes z)
  endif()

  set(optional_sources "")
  if(BUILD_LAPACK_DEPRECATED)
    list(APPEND optional_sources ${DEPRECATED})
  endif()
  if(BUILD_MATGEN)
    list(APPEND optional_sources ${MATGEN})
  endif()
  list(FILTER optional_sources INCLUDE REGEX "^lapacke_[${prefixes}]")
  list(APPEND sources ${optional_sources})

  list(TRANSFORM sources PREPEND "${lapacke_dir}/src/")
  list(TRANSFORM UTILS PREPEND "${lapacke_dir}/utils/")
  set(${result} ${sources} ${UTILS} PARENT_SCOPE)
endfunction()

openblas_lapacke_sources(lapacke_sources)
set_source_files_properties(${lapacke_sources} PROPERTIES COMPILE_FLAGS "-fvisibility=default")
